{
  "openapi": "3.0.0",
  "info": {
    "title": "Digimedia Backend API",
    "version": "1.0.0",
    "description": "API REST para el sistema de gestión de blogs, campañas WhatsApp y administración de empleados",
    "contact": {
      "name": "Digimedia Support",
      "email": "soporte@digimedia.com"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Development Server"
    },
    {
      "url": "https://api.digimedia.com",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "sanctum": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authentication token via Sanctum"
      },
      "api_key": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header",
        "description": "API Key for template endpoints"
      }
    },
    "schemas": {
      "UserResponse": {
        "type": "object",
        "title": "User Response",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Juan Pérez"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "juan@example.com"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-19T10:00:00Z"
          }
        }
      },
      "EmpleadoResponse": {
        "type": "object",
        "title": "Empleado Response",
        "properties": {
          "id_empleado": {
            "type": "integer",
            "example": 1
          },
          "nombre": {
            "type": "string",
            "example": "Juan"
          },
          "apellido": {
            "type": "string",
            "example": "Pérez"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "juan@example.com"
          },
          "dni": {
            "type": "string",
            "example": "12345678"
          },
          "telefono": {
            "type": "string",
            "nullable": true,
            "example": "987654321"
          },
          "id_user": {
            "type": "integer",
            "example": 1
          },
          "id_rol": {
            "type": "integer",
            "example": 2
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "title": "Register Request",
        "required": ["nombre", "apellido", "email", "dni", "id_rol"],
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 255,
            "example": "Juan",
            "description": "Nombre del usuario"
          },
          "apellido": {
            "type": "string",
            "maxLength": 255,
            "example": "Pérez",
            "description": "Apellido del usuario"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "example": "juan@example.com",
            "description": "Email único del usuario"
          },
          "dni": {
            "type": "string",
            "maxLength": 20,
            "example": "12345678",
            "description": "DNI único del usuario"
          },
          "telefono": {
            "type": "string",
            "nullable": true,
            "maxLength": 20,
            "example": "987654321",
            "description": "Teléfono del usuario (opcional)"
          },
          "id_rol": {
            "type": "integer",
            "example": 2,
            "description": "ID del rol a asignar (debe existir en la tabla roles)"
          }
        }
      },
      "RegisterSuccessResponse": {
        "type": "object",
        "title": "Register Success Response",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "Usuario registrado exitosamente"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "empleado": {
            "$ref": "#/components/schemas/EmpleadoResponse"
          },
          "rol": {
            "type": "string",
            "example": "administrador",
            "description": "Nombre del rol asignado"
          },
          "token": {
            "type": "string",
            "example": "1|XYZabc123...",
            "description": "Token de autenticación Sanctum para usar en requests autenticados"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "title": "Validation Error Response",
        "properties": {
          "errors": {
            "type": "object",
            "description": "Errores de validación por campo",
            "properties": {
              "nombre": {
                "type": "array",
                "items": {
                  "type": "string",
                  "example": "El campo nombre es requerido"
                }
              },
              "email": {
                "type": "array",
                "items": {
                  "type": "string",
                  "example": "El email ya ha sido registrado"
                }
              },
              "dni": {
                "type": "array",
                "items": {
                  "type": "string",
                  "example": "El DNI ya existe"
                }
              }
            }
          }
        }
      },
      "ServerErrorResponse": {
        "type": "object",
        "title": "Server Error Response",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Error al registrar usuario"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "example": "Descripción del error (solo si debug=true)"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "title": "Login Request",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "juan@example.com",
            "description": "Email del usuario registrado"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "mi_contraseña",
            "description": "Contraseña del usuario"
          }
        }
      },
      "RolResponse": {
        "type": "object",
        "title": "Rol Response",
        "properties": {
          "id_rol": {
            "type": "integer",
            "example": 1
          },
          "nombre": {
            "type": "string",
            "example": "administrador"
          },
          "descripcion": {
            "type": "string",
            "example": "Acceso total al sistema"
          }
        }
      },
      "LoginSuccessResponse": {
        "type": "object",
        "title": "Login Success Response",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "empleado": {
            "$ref": "#/components/schemas/EmpleadoResponse"
          },
          "rol": {
            "type": "string",
            "example": "administrador",
            "description": "Nombre del rol del usuario"
          },
          "permisos": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "ver-blogs"
            },
            "description": "Lista de slugs de permisos asignados al rol"
          },
          "token": {
            "type": "string",
            "example": "1|XYZabc123...",
            "description": "Token de autenticación Sanctum para autorización en requests posteriores"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "title": "Error Response",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Error description"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "title": "Reset Password Request",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "juan@example.com",
            "description": "Email del usuario para el cual se solicita recuperación de contraseña"
          }
        }
      },
      "ResetPasswordResponse": {
        "type": "object",
        "title": "Reset Password Response",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "Token de restablecimiento de contraseña enviado",
            "description": "Se envió un token al email del usuario"
          }
        }
      },
      "UpdatePasswordRequest": {
        "type": "object",
        "title": "Update Password Request",
        "required": ["token", "password", "password_confirmation"],
        "properties": {
          "token": {
            "type": "string",
            "example": "abc123xyz789...",
            "description": "Token recibido por email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "nueva_contraseña",
            "description": "Nueva contraseña (mínimo 6 caracteres)"
          },
          "password_confirmation": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "nueva_contraseña",
            "description": "Confirmación de la nueva contraseña (debe ser igual a password)"
          }
        }
      },
      "UpdatePasswordResponse": {
        "type": "object",
        "title": "Update Password Response",
        "properties": {
          "message": {
            "type": "string",
            "example": "Contraseña actualizada correctamente, ingresa desde el login"
          }
        }
      },
      "ContactanosRequest": {
        "type": "object",
        "title": "Contactanos Request",
        "required": ["nombre", "email", "numero", "mensaje"],
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 255,
            "example": "Juan Pérez",
            "description": "Nombre completo de quien contacta"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "example": "juan@example.com",
            "description": "Email válido para responder"
          },
          "numero": {
            "type": "string",
            "maxLength": 20,
            "example": "987654321",
            "description": "Número de teléfono o contacto"
          },
          "mensaje": {
            "type": "string",
            "maxLength": 1050,
            "example": "Quisiera obtener más información sobre los servicios de diseño web.",
            "description": "Mensaje o consulta (máximo 1050 caracteres)"
          }
        }
      },
      "ContactanosResponse": {
        "type": "object",
        "title": "Contactanos Response",
        "properties": {
          "status": {
            "type": "integer",
            "example": 201
          },
          "message": {
            "type": "string",
            "example": "Contacto guardado exitosamente",
            "description": "El mensaje de contacto se ha guardado correctamente en la BD"
          }
        }
      },
      "ReclamacionesRequest": {
        "type": "object",
        "title": "Reclamaciones Request",
        "required": ["nombre", "apellido", "documento", "numeroDocumento", "email", "celular", "direccion", "distrito", "ciudad", "tipoReclamo", "id_servicio", "reclamoPerson", "checkReclamoForm", "aceptaPoliticaPrivacidad", "fechaIncidente"],
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "example": "Juan",
            "description": "Nombre del reclamante"
          },
          "apellido": {
            "type": "string",
            "maxLength": 100,
            "example": "Pérez",
            "description": "Apellido del reclamante"
          },
          "documento": {
            "type": "string",
            "maxLength": 100,
            "example": "DNI",
            "description": "Tipo de documento (DNI, Pasaporte, etc.)"
          },
          "numeroDocumento": {
            "type": "string",
            "maxLength": 100,
            "example": "12345678",
            "description": "Número del documento de identidad"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "example": "juan@example.com",
            "description": "Email válido para contacto"
          },
          "celular": {
            "type": "string",
            "maxLength": 20,
            "example": "987654321",
            "description": "Número de celular"
          },
          "direccion": {
            "type": "string",
            "maxLength": 250,
            "example": "Calle Principal 123",
            "description": "Dirección del domicilio"
          },
          "distrito": {
            "type": "string",
            "maxLength": 250,
            "example": "San Isidro",
            "description": "Distrito del domicilio"
          },
          "ciudad": {
            "type": "string",
            "maxLength": 250,
            "example": "Lima",
            "description": "Ciudad del domicilio"
          },
          "tipoReclamo": {
            "type": "string",
            "maxLength": 20,
            "enum": ["queja", "reclamo", "sugerencia"],
            "example": "reclamo",
            "description": "Tipo de reclamación"
          },
          "id_servicio": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "example": 1,
            "description": "ID del servicio (1-4)"
          },
          "reclamoPerson": {
            "type": "string",
            "maxLength": 1050,
            "example": "Descripcjón detallada de la reclamación...",
            "description": "Descripción detallada de la reclamación (máximo 1050 caracteres)"
          },
          "checkReclamoForm": {
            "type": "boolean",
            "example": true,
            "description": "Confirmación de verédicidad de datos"
          },
          "aceptaPoliticaPrivacidad": {
            "type": "boolean",
            "example": true,
            "description": "Aceptación de la política de privacidad"
          },
          "fechaIncidente": {
            "type": "string",
            "format": "date",
            "example": "2026-03-19",
            "description": "Fecha en que ocurrió el incidente (formato: YYYY-MM-DD)"
          }
        }
      },
      "ReclamacionesResponse": {
        "type": "object",
        "title": "Reclamaciones Response",
        "properties": {
          "message": {
            "type": "string",
            "example": "Reclamación guardada exitosamente",
            "description": "Confirmación del registro guardado"
          },
          "data": {
            "type": "object",
            "description": "Objeto completo de la reclamación guardada con todos sus campos y ID"
          }
        }
      }
    }
  },
  "paths": {
    "/register": {
      "post": {
        "tags": ["Authentication"],
        "operationId": "register",
        "summary": "Registrar nuevo usuario",
        "description": "Crea un nuevo usuario y empleado en el sistema. Asigna un rol específico y genera un token de autenticación.",
        "requestBody": {
          "required": true,
          "description": "Datos necesarios para registrar un nuevo usuario",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario registrado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterSuccessResponse"
                }
              }
            }
          },
          "422": {
            "description": "Error de validación - Datos inválidos o duplicados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Authentication"],
        "operationId": "login",
        "summary": "Iniciar sesión",
        "description": "Autentica un usuario con sus credenciales (email y contraseña). Retorna los datos del usuario, empleado, roles, permisos y un token Sanctum para autorización.",
        "requestBody": {
          "required": true,
          "description": "Credenciales de autenticación",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSuccessResponse"
                }
              }
            }
          },
          "404": {
            "description": "Usuario no registrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Esta cuenta no está registrada en Digimedia."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas (email o contraseña incorrectos)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "El email o la contraseña son incorrectos."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Usuario sin rol asignado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "El usuario no tiene un rol asignado"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reset_password": {
      "post": {
        "tags": ["Authentication"],
        "operationId": "resetPassword",
        "summary": "Solicitar restablecimiento de contraseña",
        "description": "Envía un token de restablecimiento de contraseña al email del usuario. El usuario recibirá un email con instrucciones para restablecer su contraseña.",
        "requestBody": {
          "required": true,
          "description": "Email del usuario",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token enviado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetPasswordResponse"
                }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/update_password": {
      "post": {
        "tags": ["Authentication"],
        "operationId": "updatePassword",
        "summary": "Actualizar contraseña",
        "description": "Actualiza la contraseña del usuario utilizando el token enviado por email. El token debe ser válido y no estar expirado.",
        "requestBody": {
          "required": true,
          "description": "Token y nueva contraseña",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña actualizada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdatePasswordResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validación fallida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Token inválido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/contactanos": {
      "post": {
        "tags": ["Contactanos"],
        "operationId": "createContactanos",
        "summary": "Enviar mensaje de contacto",
        "description": "Permite a cualquier persona enviar un mensaje de contacto. El mensaje se guarda en la base de datos para que el equipo de soporte pueda responder. NO requiere autenticación.",
        "requestBody": {
          "required": true,
          "description": "Datos del contacto",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactanosRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mensaje de contacto guardado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactanosResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validación fallida - Campos incompletos o inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reclamaciones": {
      "post": {
        "tags": ["Reclamaciones"],
        "operationId": "createReclamaciones",
        "summary": "Registrar una reclamación",
        "description": "Permite registrar una reclamación, queja o sugerencia. Se requieren datos completos del reclamante y descripción del incidente. NO requiere autenticación. Los datos se guardan en el libro de reclamaciones.",
        "requestBody": {
          "required": true,
          "description": "Datos completos de la reclamación",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReclamacionesRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reclamación registrada exitosamente en el libro de reclamaciones",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReclamacionesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validación fallida - Campos incompletos, inválidos o fuera de rango",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
